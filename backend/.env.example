# Brand Protection
BRAND_STOPLIST_EXTRA=                    # comma-separated extra stoplist words; unioned with DEFAULT_STOPLIST
BRAND_NOISE_THRESHOLD=100                # matches/24h that auto-downgrade a term to watch_only
BRAND_WEBHOOK_SEVERITY_THRESHOLD=HIGH    # HIGH|MEDIUM — threshold for synth + webhook firing
BRAND_MONITOR_INTERVAL_SECONDS=900       # APScheduler interval for brand_monitor_tick (default 15 min)
