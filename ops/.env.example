# IntelliBird M1 .env — copy to ops/.env and replace every CHANGEME value.
#
# Generate SECRET_KEY with:
#   openssl rand -hex 32
#
# The backend REFUSES TO START if SECRET_KEY is still "CHANGEME" or shorter
# than 32 characters. See backend/app/config.py.

# --- Postgres ---
POSTGRES_DB=intellibird
POSTGRES_USER=intellibird
POSTGRES_PASSWORD=CHANGEME

# DATABASE_URL uses the asyncpg driver for SQLAlchemy async + Alembic.
# Inside compose, host is the service name "db".
DATABASE_URL=postgresql+asyncpg://intellibird:CHANGEME@db:5432/intellibird

# --- Redis (Dramatiq broker) ---
REDIS_URL=redis://redis:6379/0

# --- App secrets ---
SECRET_KEY=CHANGEME

# --- Bind policy ---
# HOST is read by the API at startup to detect non-loopback deployment.
# If HOST != 127.0.0.1, the web stub renders an unavoidable warning banner
# on every route. Do not set this to 0.0.0.0 outside a trusted internal
# network — M1 has no authentication.
HOST=127.0.0.1
PORT=8000

# --- Phase 8 / Pre-Auth Infra Hardening ---
# Flip to true when Phase 9 auth is ready. Controls AuthMiddleware (backend) +
# Route Handler proxy header strip (frontend). See docs/ops/secret-rotation.md.
AUTH_ENABLED=false

# Required ONLY during a SECRET_KEY rotation. Set alongside REKEY_FROM_SECRET,
# run POST /api/admin/rekey-credentials with header X-Setup-Token: <this value>,
# then UNSET both. See docs/ops/secret-rotation.md.
# SETUP_TOKEN=

# The PREVIOUS SECRET_KEY. Set during rekey, unset after. If unset the rekey
# endpoint returns 400. See docs/ops/secret-rotation.md.
# REKEY_FROM_SECRET=

# --- Phase 9 / Authentication (AUTH-01..04) ---
# JWT_SIGNING_KEY — HS256 signing key for session tokens.
#   Generate:  openssl rand -hex 32
#   REQUIRED — no default; startup aborts when unset or placeholder-equivalent.
#   Separate from SECRET_KEY: rotating SECRET_KEY for credentials rekey must NOT
#   invalidate live sessions, and rotating JWT_SIGNING_KEY for session reset must
#   NOT touch credentials. See docs/ops/auth-setup.md.
JWT_SIGNING_KEY=

# AUTH_SECRET — Auth.js v5 JWE encryption + CSRF signing key (frontend).
#   Generate:  openssl rand -hex 32
#   REQUIRED — web container aborts with MissingSecret when unset.
AUTH_SECRET=

# --- Authentik OIDC (optional — enables /api/auth/oidc/* + /login SSO button) ---
# Unset to run with local accounts only. See docs/ops/auth-setup.md.
# SSO_ISSUER_URL=http://authentik:9000/application/o/intellibird/
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_GROUPS_CLAIM=groups
# SSO_ADMIN_GROUPS=intellibird-admins
# SSO_ANALYST_GROUPS=intellibird-analysts
# SSO_VIEWER_GROUPS=intellibird-viewers

# --- Authentik compose profile (only needed when running `docker compose --profile sso up -d`) ---
# AUTHENTIK_PG_DB=authentik
# AUTHENTIK_PG_USER=authentik
# AUTHENTIK_PG_PASS=<openssl rand -base64 24>
# AUTHENTIK_SECRET_KEY=<openssl rand -base64 60>

# --- Phase 11: EASM via BBOT ---
# easm-worker service — only needed when running `docker compose up easm-worker`
# BBOT runs inside a dedicated Docker subprocess; the easm-worker container
# requires /var/run/docker.sock (elevated privilege). See docs/ops/easm.md.
BBOT_PASSIVE_MAX_SECONDS=7200
BBOT_ACTIVE_MAX_SECONDS=1800
BBOT_CONCURRENT_LIMIT=2
BBOT_SCAN_HISTORY_LIMIT=5
BBOT_EXPERIMENTAL_OVERRIDE=
BBOT_IMAGE_TAG=blacklanternsecurity/bbot:stable
BBOT_ACTIVE_AUTH_TTL_SECONDS=604800
