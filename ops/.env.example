# IntelliBird M1 .env — copy to ops/.env and replace every CHANGEME value.
#
# Generate SECRET_KEY with:
#   openssl rand -hex 32
#
# The backend REFUSES TO START if SECRET_KEY is still "CHANGEME" or shorter
# than 32 characters. See backend/app/config.py.

# --- Postgres ---
POSTGRES_DB=intellibird
POSTGRES_USER=intellibird
POSTGRES_PASSWORD=CHANGEME

# DATABASE_URL uses the asyncpg driver for SQLAlchemy async + Alembic.
# Inside compose, host is the service name "db".
DATABASE_URL=postgresql+asyncpg://intellibird:CHANGEME@db:5432/intellibird

# --- Redis (Dramatiq broker) ---
REDIS_URL=redis://redis:6379/0

# --- App secrets ---
SECRET_KEY=CHANGEME

# --- Bind policy ---
# HOST is read by the API at startup to detect non-loopback deployment.
# If HOST != 127.0.0.1, the web stub renders an unavoidable warning banner
# on every route. Do not set this to 0.0.0.0 outside a trusted internal
# network — M1 has no authentication.
HOST=127.0.0.1
PORT=8000
